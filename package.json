{
  "name": "discord-ai-server-manager",
  "version": "0.1.0",
  "private": true,
  "description": "Discord AI Server Manager - natural language server administration with permission-guarded tools",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/src/app.js",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/src/app.js",
    "typecheck": "tsc --noEmit && npm run lint:deps",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "register:commands": "tsx src/modules/discord/deploy-commands.ts",
    "db:push": "drizzle-kit push",
    "ingest": "tsx src/modules/knowledge/ingest-cli.ts",
    "backfill": "tsx scripts/backfill-knowledge.ts",
    "medication:test": "tsx scripts/medication-test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1124.0",
    "@aws-sdk/s3-request-presigner": "^3.1124.0",
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.12",
    "@langchain/openai": "^1.5.10",
    "@payos/node": "^1.0.10",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.4",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.6",
    "dependency-cruiser": "^18.2.0",
    "drizzle-kit": "^0.31.10",
    "tsc-alias": "^1.9.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
