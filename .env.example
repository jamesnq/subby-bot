DISCORD_TOKEN=your-discord-bot-token
DISCORD_CLIENT_ID=your-application-id
DISCORD_GUILD_ID=optional-dev-guild-id-for-instant-command-registration
ADMIN_DISCORD_ID=your-admin-user-id-full-admin-bypass

OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=stealth/ox-alpha
LLM_SMALL_MODEL=stealth/ox-alpha
LLM_TIMEOUT_MS=60000

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-before-production
POSTGRES_DB=discord_ai
DATABASE_URL=postgres://postgres:change-this-before-production@localhost:5432/discord_ai

LOG_LEVEL=info
HEALTH_PORT=3000
INSTANCE_LOCK_PORT=39127
APPROVAL_TTL_SECONDS=600
MAX_TOOL_CALLS_PER_REQUEST=10
MAX_RESOURCES_PER_PLAN=5
RATE_LIMIT_USER_PER_MINUTE=10
CONVERSATION_SESSION_ENABLED=true
CONVERSATION_SESSION_TIMEOUT_MINUTES=5
CONVERSATION_SESSION_FOLLOWUP_ENABLED=true
KNOWLEDGE_SCORE_THRESHOLD=0.15
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=liquid/lfm-2.5-embedding-350m:free
VECTOR_DIMS=1024
KNOWLEDGE_CACHE_TTL_HOURS=24
GUILD_DAILY_LLM_CALLS_LIMIT=500
GUILD_DAILY_TOKEN_LIMIT=300000

PROACTIVE_TOPIC_ENABLED=false
PROACTIVE_TOPIC_INTERVAL_MINUTES=120
PROACTIVE_TOPIC_MAX_PER_GUILD_DAY=3
PROACTIVE_TOPIC_QUIET_START=23:00
PROACTIVE_TOPIC_QUIET_END=07:00
PROACTIVE_TOPIC_IDLE_MINUTES=45
PROACTIVE_TOPIC_HISTORY_LIMIT=20



