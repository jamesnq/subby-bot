DISCORD_TOKEN=your-discord-bot-token
DISCORD_CLIENT_ID=your-application-id
DISCORD_GUILD_ID=optional-dev-guild-id-for-instant-command-registration
ADMIN_DISCORD_ID=your-admin-user-id-full-admin-bypass

OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=stealth/ox-alpha
LLM_SMALL_MODEL=stealth/ox-alpha
LLM_TIMEOUT_MS=60000

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-before-production
POSTGRES_DB=discord_ai
DATABASE_URL=postgres://postgres:change-this-before-production@localhost:5432/discord_ai

LOG_LEVEL=info
HEALTH_PORT=3000
INSTANCE_LOCK_PORT=39127
APPROVAL_TTL_SECONDS=600
MAX_TOOL_CALLS_PER_REQUEST=10
MAX_RESOURCES_PER_PLAN=5
RATE_LIMIT_USER_PER_MINUTE=10
STATE_BACKEND=memory
CONVERSATION_SESSION_ENABLED=true
CONVERSATION_SESSION_TIMEOUT_MINUTES=5
CONVERSATION_SESSION_FOLLOWUP_ENABLED=true
KNOWLEDGE_SCORE_THRESHOLD=0.15
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=liquid/lfm-2.5-embedding-350m:free
VECTOR_DIMS=1024
KNOWLEDGE_CACHE_TTL_HOURS=24
GUILD_DAILY_LLM_CALLS_LIMIT=500
GUILD_DAILY_TOKEN_LIMIT=300000

CODE_ACCESS_ENABLED=false
CODE_ACCESS_USER_DAILY_LIMIT=3
CODE_ACCESS_GUILD_DAILY_LIMIT=100

GMAIL_ENABLED=false
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER_ID=me
GMAIL_STEAM_FROM=noreply@steampowered.com
GMAIL_STEAM_QUERY_WINDOW_DAYS=14
# Strips Steam Guard codes and account links from mail text before it reaches Discord.
# Setting this to false relays live 2FA codes into the channel - only do that on a
# channel that nobody but you can read.
GMAIL_REDACT_SENSITIVE=true

PROACTIVE_TOPIC_ENABLED=false
PROACTIVE_TOPIC_INTERVAL_MINUTES=120
PROACTIVE_TOPIC_MAX_PER_GUILD_DAY=3
PROACTIVE_TOPIC_QUIET_START=23:00
PROACTIVE_TOPIC_QUIET_END=07:00
PROACTIVE_TOPIC_IDLE_MINUTES=45
PROACTIVE_TOPIC_HISTORY_LIMIT=20

# --- Code access redesign (CODE-ACCESS-REDESIGN-PLAN.md) ---
# Not read by src/config/index.ts yet; add to the zod schema in step 1 of the plan.

# S3 / MinIO - stores purchase + device screenshots. Bucket must stay private:
# images are full-desktop screenshots and are served only via presigned URLs.
# Use a bot-only key scoped to <bucket>/user_att/*, not the shared web key.
S3_ENABLED=false
S3_ENDPOINT=https://s3.example.com
S3_BUCKET=your-bucket
S3_REGION=ap-southeast-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=user_att/
S3_PRESIGN_TTL_SECONDS=900

# OCR - reads order bills and Windows device info from screenshots
OCR_ENABLED=false
OCR_BASE_URL=https://cheapkeyai.shop/v1
OCR_MODEL=gemini-2.5-flash-lite
OCR_API_KEY=
OCR_TIMEOUT_MS=45000
OCR_MAX_OUTPUT_TOKENS=700

# Code access decision thresholds.
# CODE_ACCESS_ISSUE_CODES=true makes the bot hand live Steam Guard codes to
# entitled users. It inverts the default refuse-to-relay-MFA posture, so keep it
# false until the seven gates in the plan are in place.
CODE_ACCESS_ISSUE_CODES=false
CODE_ACCESS_REQUEST_DAILY_LIMIT=5
CODE_ACCESS_SCREENSHOT_MAX_AGE_MINUTES=30
# warn = log only, suspend = block on Windows version upgrade
CODE_ACCESS_OS_POLICY=warn
CODE_ACCESS_ESCALATE_BELOW=0.80
CODE_ACCESS_AUTO_APPROVE_ABOVE=0.90
SUPPORT_FANPAGE_URL=

