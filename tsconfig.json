{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@config": ["src/config"],
      "@shared/*": ["src/shared/*"],
      "@infra/*": ["src/infrastructure/*"],
      "@agent/*": ["src/modules/agent/*"],
      "@approvals/*": ["src/modules/approvals/*"],
      "@code-access/*": ["src/modules/code-access/*"],
      "@database/*": ["src/modules/database/*"],
      "@discord/*": ["src/modules/discord/*"],
      "@feedback/*": ["src/modules/feedback/*"],
      "@gmail/*": ["src/modules/gmail/*"],
      "@jobs/*": ["src/modules/jobs/*"],
      "@knowledge/*": ["src/modules/knowledge/*"],
      "@observability/*": ["src/modules/observability/*"],
      "@policies/*": ["src/modules/policies/*"],
      "@tools/*": ["src/modules/tools/*"]
    },
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "drizzle.config.ts"],
  "exclude": ["node_modules", "dist"]
}
